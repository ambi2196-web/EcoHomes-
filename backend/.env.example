# EcoHomes Backend — Environment Variables
# Copy this file to .env and fill in your keys

# ── AI Consultation (Phase 3) ─────────────────────────────────────────────
# Groq — free 14,400 req/day, no credit card → https://console.groq.com
# Uses llama-3.3-70b-versatile (fast, free tier)
GROQ_API_KEY=

# Google Gemini — free 15 req/min → https://aistudio.google.com/app/apikey
# Used as fallback if GROQ_API_KEY is not set
GEMINI_API_KEY=

# If neither key is set, the app uses built-in rule-based ENS advice.
# The app is fully functional offline without any API keys.

# ── No keys needed for ───────────────────────────────────────────────────
# - OpenStreetMap / Nominatim (geocoding)
# - Open-Meteo (weather/climate data)
# - NASA POWER API (solar irradiance)
# - Leaflet / OpenStreetMap map tiles
