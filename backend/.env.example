# Copy this file to .env and fill in your keys

# LLM APIs (get free keys below)
# Groq — free 14,400 req/day → https://console.groq.com
GROQ_API_KEY=

# Google Gemini — free 15 req/min → https://aistudio.google.com
GEMINI_API_KEY=

# No keys needed for:
# - OpenStreetMap / Nominatim (geocoding)
# - Open-Meteo (weather/climate)
# - NASA POWER API (solar data)
# - Leaflet / OpenStreetMap tiles
